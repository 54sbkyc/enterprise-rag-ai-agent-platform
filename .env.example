# Optional LLM provider. Leave empty to use local extractive answers.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_INPUT_COST_PER_1K=0
LLM_OUTPUT_COST_PER_1K=0
LLM_TIMEOUT_SECONDS=20
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_SECONDS=0.25
LLM_RETRY_MAX_SECONDS=2

# Optional OpenAI-compatible embedding endpoint. Leave model empty for BM25-only retrieval.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_ATTEMPTS=3
EMBEDDING_RETRY_BASE_SECONDS=0.25
EMBEDDING_RETRY_MAX_SECONDS=2

# Shared provider protection. Limits are process-local and apply across chat, embeddings, and planner calls.
MODEL_GATEWAY_CIRCUIT_FAILURE_THRESHOLD=5
MODEL_GATEWAY_CIRCUIT_COOLDOWN_SECONDS=30
MODEL_GATEWAY_MAX_RESPONSE_BYTES=5242880

# Vector storage. SQLite JSON is the zero-service default; pgvector removes the Python full-vector scan.
RAG_VECTOR_STORE=sqlite
RAG_VECTOR_STORE_FALLBACK=true
PGVECTOR_DSN=
# Must match the selected embedding model and stay at or below the indexed vector limit.
PGVECTOR_DIMENSIONS=1536
PGVECTOR_CONNECT_TIMEOUT_SECONDS=5
PGVECTOR_POOL_MIN_SIZE=1
PGVECTOR_POOL_MAX_SIZE=5
# Used by compose.pgvector.yaml only. Set a long random value before starting that profile.
PGVECTOR_PASSWORD=

# Bounded first-stage retrieval. Invalid values fall back to these defaults.
RAG_LEXICAL_CANDIDATE_LIMIT=200
RAG_VECTOR_CANDIDATE_LIMIT=100

# Optional model planner. Tools remain allow-listed and permission checked.
AGENT_PLANNER_ENABLED=false
AGENT_PLANNER_MODEL=
AGENT_PLANNER_TIMEOUT_SECONDS=15
AGENT_PLANNER_MAX_ATTEMPTS=2
AGENT_PLANNER_RETRY_BASE_SECONDS=0.25
AGENT_PLANNER_RETRY_MAX_SECONDS=2
AGENT_TOOL_TIMEOUT_SECONDS=25
AGENT_TOOL_MAX_ATTEMPTS=2
AGENT_TASK_WORKERS=2
AGENT_TASK_MAX_ACTIVE_PER_USER=3

# Optional local storage overrides.
RAG_DB_PATH=backend/data/rag_platform.db
RAG_UPLOAD_DIR=backend/data/uploads

# Runtime profile. Local PowerShell startup uses development. Docker Compose forces production.
RAG_RUNTIME_ENV=development
RAG_BOOTSTRAP_ADMIN_USERNAME=admin
# Required on the first production/container startup; use at least 12 characters.
RAG_BOOTSTRAP_ADMIN_PASSWORD=
# Host port used only by compose.yaml.
RAG_HTTP_PORT=8000

# Runtime hardening. CORS stays disabled for the same-origin frontend when empty.
RAG_SESSION_TTL_HOURS=12
# Refuse answers when key question conditions are not covered by retrieved evidence.
RAG_MIN_EVIDENCE_COVERAGE=0.5
RAG_MAX_UPLOAD_MB=10
RAG_CORS_ORIGINS=
