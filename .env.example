# Optional LLM provider. Leave empty to use local extractive answers.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_INPUT_COST_PER_1K=0
LLM_OUTPUT_COST_PER_1K=0

# Optional OpenAI-compatible embedding endpoint. Leave model empty for BM25-only retrieval.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=30

# Optional model planner. Tools remain allow-listed and permission checked.
AGENT_PLANNER_ENABLED=false
AGENT_PLANNER_MODEL=
AGENT_PLANNER_TIMEOUT_SECONDS=15
AGENT_TOOL_TIMEOUT_SECONDS=25
AGENT_TOOL_MAX_ATTEMPTS=2
AGENT_TASK_WORKERS=2
AGENT_TASK_MAX_ACTIVE_PER_USER=3

# Optional local storage overrides.
RAG_DB_PATH=backend/data/rag_platform.db
RAG_UPLOAD_DIR=backend/data/uploads

# Runtime hardening. CORS stays disabled for the same-origin frontend when empty.
RAG_SESSION_TTL_HOURS=12
# Refuse answers when key question conditions are not covered by retrieved evidence.
RAG_MIN_EVIDENCE_COVERAGE=0.7
RAG_MAX_UPLOAD_MB=10
RAG_CORS_ORIGINS=
